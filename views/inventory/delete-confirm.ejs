<h1>Delete Inventory Item</h1>

<%- include('../partials/messages') %>

<p class="warning">
  Confirm Deletion – This action is permanent and cannot be undone.
</p>

<form action="/inv/delete" method="POST" novalidate>

  <!-- Hidden field for inventory ID (REQUIRED) -->
  <input
    type="hidden"
    name="inv_id"
    value="<%= typeof inv_id !== 'undefined' ? inv_id : '' %>"
  >

  <!-- Make -->
  <label for="invMake">Make</label>
  <input
    type="text"
    id="invMake"
    value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>"
    readonly
  >

  <!-- Model -->
  <label for="invModel">Model</label>
  <input
    type="text"
    id="invModel"
    value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>"
    readonly
  >

  <!-- Year -->
  <label for="invYear">Year</label>
  <input
    type="number"
    id="invYear"
    value="<%= typeof inv_year !== 'undefined' ? inv_year : '' %>"
    readonly
  >

  <!-- Price -->
  <label for="invPrice">Price</label>
  <input
    type="number"
    step="0.01"
    id="invPrice"
    value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>"
    readonly
  >

  <button type="submit">Delete</button>
</form>

